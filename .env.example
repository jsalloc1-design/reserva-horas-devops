# Archivo de ejemplo de variables de entorno.
# Copiar como .env y ajustar valores locales. NUNCA subir el archivo .env al repositorio.
# No incluir credenciales reales, tokens ni datos personales.

# Puerto local donde se publicará el servicio
APP_PORT=8080

# Entorno de ejecución (desarrollo | pruebas)
APP_ENV=desarrollo

# Ejemplo de variable sensible (solo marcador, sin valor real)
# API_TOKEN=reemplazar_por_valor_local
